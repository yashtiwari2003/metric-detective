# ── Metric Detective — .env.example ──────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# LLM Configuration
LLM_PROVIDER=gemini          # Options: gemini, openai, groq
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-2.5-flash-lite

# Database
DB_URL=duckdb:///data/metric.duckdb   # Switch to postgresql://user:pass@host/db for Postgres

# Kaggle (for data download)
KAGGLE_KEY=your-kaggle-api-token-here
